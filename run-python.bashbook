{"cells":[{"kind":1,"languageId":"markdown","value":"# Python Backend Setup\n\n**Requirements:** Python 3.10+\n\n**Note:** No environment variables need to be configured.","metadata":{}},{"kind":2,"languageId":"shellscript","value":"# Create and activate virtual environment\nuv venv","metadata":{}},{"kind":2,"languageId":"shellscript","value":"source .venv/bin/activate","metadata":{}},{"kind":2,"languageId":"shellscript","value":"# Install dependencies\nuv pip install -r requirements.txt","metadata":{}},{"kind":2,"languageId":"shellscript","value":"python manage.py makemigrations","metadata":{}},{"kind":2,"languageId":"shellscript","value":"# Apply database migrations\npython manage.py migrate","metadata":{}},{"kind":2,"languageId":"shellscript","value":"# Start Django server (after Vue dev server is running!)\nDEBUG=1 python manage.py runserver","metadata":{}},{"kind":2,"languageId":"shellscript","value":"","metadata":{}}]}